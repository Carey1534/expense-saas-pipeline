        "jsCode": "// Postgres output item (no binary)\nconst item = $input.first();\n\n// Pull binary + original metadata from Validate Input\nconst validateNode = $('Validate Input').first();\n\n// DB values\nconst document_id = item.json.id;\nconst is_new = item.json.is_new;\n\n// Authoritative metadata\nconst org_id = validateNode.json.org_id;\nconst fileName = validateNode.json.fileName || 'unknown';\nconst ext = (fileName.split('.').pop() || 'bin').toLowerCase();\n\n// Deterministic S3 path\nconst file_path = `org_${org_id}/documents/${document_id}/original.${ext}`;\n\nreturn [{\n  json: {\n    ...validateNode.json,   // org_id, source, fileName, file_hash, etc\n    ...item.json,           // id, is_new\n    document_id,\n    file_path,\n    is_new,\n  },\n  binary: validateNode.binary   // ✅ reattached here\n}];"
