    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst body = $json.body ?? $json; // depending on webhook config\nconst org_id = body.org_id;\nconst source = body.source || 'web_upload';\nconst project_id = body.project_id || null;\nconst client_id  = body.client_id || null;\n\n// Find binary property name\nconst bin = $binary;\nconst binKey = Object.keys(bin || {})[0];\nif (!org_id) throw new Error('Missing org_id');\nif (!binKey) throw new Error('Missing file binary upload');\n\n// File metadata\nconst fileName = bin[binKey].fileName || 'upload';\nconst mimeType = bin[binKey].mimeType || 'application/octet-stream';\n\n// Compute SHA256 hash of file bytes\nconst buf = await this.helpers.getBinaryDataBuffer(0, binKey);\nconst file_hash = crypto.createHash('sha256').update(buf).digest('hex');\n\nreturn [{\n  json: {\n    org_id,\n    source,\n    binKey,\n    fileName,\n    mimeType,\n    file_hash,\n    project_id,\n    client_id\n  },\n  binary: $binary\n}];\n\n"
