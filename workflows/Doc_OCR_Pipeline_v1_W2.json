  "name": "Doc_OCR_Pipeline_v1_W2",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const doc = $json.ExpenseDocuments?.[0];\n\nif (!doc) {\n  throw new Error(\"NO_EXPENSE_DOCUMENT_FOUND\");\n}\n\n// --------------------\n// Structured fields\n// --------------------\nconst summary = doc.SummaryFields ?? [];\n\nfunction getField(name) {\n  const field = summary.find(f =>\n    f.Type?.Text?.toLowerCase().includes(name)\n  );\n  return field?.ValueDetection?.Text ?? null;\n}\n\nlet vendor = getField('vendor');\nlet total = getField('total');\nlet tax = getField('tax');\nlet date = getField('date');\n\n// --------------------\n// Fallback: raw line scan\n// --------------------\nif (!date && doc.Blocks) {\n  const text = doc.Blocks\n    .filter(b => b.BlockType === 'LINE')\n    .map(b => b.Text)\n    .join('\\n');\n\n  const match = text.match(/\\b\\d{1,2}[\\/\\-]\\d{1,2}[\\/\\-]\\d{2,4}\\b/);\n  if (match) date = match[0];\n}\n\n// --------------------\n// Normalize Date\n// --------------------\nfunction normalizeDate(dateStr) {\n  if (!dateStr) return null;\n\n  const m = dateStr.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{2,4})$/);\n  if (!m) return null;\n\n  let [_, month, day, year] = m;\n  if (year.length === 2) year = \"20\" + year;\n\n  return `${year}-${month.padStart(2,'0')}-${day.padStart(2,'0')}`;\n}\n\n// --------------------\n// Clean Numbers\n// --------------------\nfunction cleanNumber(val) {\n  if (!val) return null;\n\n  const num = Number(val.replace(/[^0-9.]/g, ''));\n  return isNaN(num) ? null : num;\n}\n\n// --------------------\n// Final Normalized Object\n// --------------------\nconst normalized = {\n  vendor_name: vendor ?? null,\n  total_amount: cleanNumber(total),\n  tax_amount: cleanNumber(tax),\n  expense_date: normalizeDate(date),\n  currency: 'USD',\n  confidence_score: 0.9,\n  needs_review: false\n};\n\n// --------------------\n// OCR Run Metadata\n// --------------------\nconst ocr_run = {\n  document_id: $json.context?.document_id ?? null,\n  provider: 'aws_textract',\n  ocr_confidence: normalized.confidence_score,\n  raw_text: JSON.stringify(normalized)\n};\n\nreturn [{\n  json: {\n    ...normalized,\n    ...ocr_run\n  }\n}];\n"
      },
