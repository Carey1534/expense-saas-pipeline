      "parameters": {
        "jsCode": "function csvEscape(v) {\n  if (v === null || v === undefined) return '';\n  const s = String(v);\n  if (/[\",\\n]/.test(s)) return `\"${s.replace(/\"/g,'\"\"')}\"`;\n  return s;\n}\n\nconst rows = $input.all().map(i => i.json);\n\nconst headers = [\n  'expense_date','vendor_name','total_amount','tax_amount','currency','project_code','document_id'\n];\n\nlet csv = headers.join(',') + '\\n';\nfor (const r of rows) {\n  // Line 16 in your code\ncsv += headers.map(h => {\n  const val = csvEscape(r[h]);\n  // Format date if it's the expense_date field\n  if (h === 'expense_date' && val) {\n    return val.split('T')[0]; // Returns just 2026-02-01\n  }\n  return val;\n}).join(',') + '\\n';\n}\n\nreturn [{\n  filename: `expenses_export_${new Date().toISOString().split('T')[0]}.csv`\n}];\n"
      },
